{
  "container": "docker.io/assistos/ploinky-node:24-bookworm-tools",
  "runtime": {
    "resources": {
      "persistentStorage": {
        "key": "dpu-data",
        "containerPath": "/dpu-data"
      },
      "env": {
        "DPU_DATA_ROOT": "{{STORAGE_CONTAINER_PATH}}",
        "DPU_WORKSPACE_ROOT": "{{WORKSPACE_ROOT}}",
        "DPU_MASTER_KEY": "{{generatedSecret:DPU_MASTER_KEY}}"
      }
    }
  },
  "profiles": {
    "default": {
      "env": [
        "ASSISTOS_FS_ROOT",
        "WORKSPACE_ROOT"
      ]
    }
  }
}
