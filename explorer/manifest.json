{
    "container": "node:20-alpine",
    "preinstall": "npm install",
    "postinstall": "apk add --no-cache git openssh-client ca-certificates",
    "update": "",
    "cli": "/bin/bash",
    "agent": "node /code/filesystem-http-server.mjs",
    "about": "AssistOS Explorer agent",
    "enable": [
        "soplang",
        "multimedia",
        "soplangAgent global"
    ],
    "env": [
        "ASSISTOS_FS_ROOT"
    ],
    "repos": {"soplangBuilder": "https://github.com/PloinkyRepos/SOPLangBuilder.git"}
}
