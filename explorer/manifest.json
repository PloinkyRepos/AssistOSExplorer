{
    "container": "docker.io/assistos/ploinky-node:24-bookworm-tools",
    "lite-sandbox": true,
    "update": "",
    "cli": "/bin/bash",
    "about": "AssistOS Explorer agent",
    "ploinky": "sso enable",
    "enable": [
        {
            "agent": "gitAgent global",
            "profile": "embedded"
        },
        "dpuAgent global",
        "soplangAgent global no-wait",
        "tasksAgent global",
        "AchillesCLI/achilles-cli global no-wait",
        "basic/webtty global",
        "webmeetInfra/liveKitServerAgent no-wait",
        "webmeetStt no-wait",
        "webmeetAgent global no-wait",
        "userPersistoAgent global",
        "emailAgent global",
        "multimedia global no-wait",
        "onlyOffice global no-wait",
        "proxies/soul-gateway no-wait",
        "webAssist no-wait",
        "UmamiAgent/umamiAgent no-wait"
    ],
    "repos": {
        "webmeetInfra": "https://github.com/AssistOS-AI/webmeetInfra.git",
        "UmamiAgent": "https://github.com/AssistOS-AI/UmamiAgent.git"
    },
    "applicationPlugins": {
        "git": true,
        "dpu-runtime-support": true,
        "dpu-audit-menu": true,
        "soplang-builder": true,
        "tasks": true,
        "webmeet": true,
        "soul-gateway": true
    },
    "routerAccess": {
        "requiredCapability": "explorer.access",
        "httpRoutes": [
            {
                "path": "/shared/*",
                "access": "public"
            }
        ]
    },
    "profiles": {
        "default": {
            "env": [
                "ASSISTOS_FS_ROOT",
                {
                    "name": "SOUL_GATEWAY_BASE_URL",
                    "required": false
                },
                {
                    "name": "AXIFACE_REPO_PATH",
                    "required": false
                },
                {
                    "name": "ONLYOFFICE_PUBLIC_URL",
                    "required": false
                },
                {
                    "name": "ONLYOFFICE_INTERNAL_URL",
                    "required": false
                },
                {
                    "name": "ONLYOFFICE_JWT_SECRET",
                    "required": true,
                    "sharedGeneratedSecret": true
                },
                {
                    "name": "ONLYOFFICE_CALLBACK_BASE_URL",
                    "required": false
                }
            ],
            "preinstall": "scripts/hooks/preinstall.sh"
        }
    }
}
