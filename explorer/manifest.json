{
    "container": "node:20-bullseye",
    "update": "",
    "cli": "/bin/bash",
    "agent": "node /code/filesystem-http-server.mjs",
    "about": "AssistOS Explorer agent",
    "enable": [
        "soplang",
        "multimedia",
        "explorerSkillsAgent",
        "soplangAgent global"
    ],
    "repos": {
        "soplangBuilder": "https://github.com/PloinkyRepos/SOPLangBuilder.git"
    },
    "profiles": {
        "default": {
            "env": [
                "ASSISTOS_FS_ROOT"
            ],
            "preinstall": "npm install"
        }
    }
}
