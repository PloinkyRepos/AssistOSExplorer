{
    "lite-sandbox": true,
    "container": "node:20-bullseye",
    "update": "",
    "cli": "/bin/bash",
    "agent": "node /code/filesystem-http-server.mjs",
    "about": "AssistOS Explorer agent",
    "repos": {
        "webassist": "https://github.com/AssistOS-AI/webassist.git"
    },
    "ploinky": "pwd enable",
    "pwd": {
        "users": [
            {
                "username": "admin",
                "password": "admin",
                "name": "Admin"
            },
            {
                "username": "user",
                "password": "user",
                "name": "User"
            }
        ]
    },
    "enable": [
        "postgres",
        "keycloak",
        "gitAgent global",
        "dpuAgent global",
        "soplangAgent global",
        "tasksAgent global",
        "llmAssistant global",
        "multimedia global",
        "webassist/webCli global",
        "webassist/webAdmin global"
    ],
    "applicationPlugins": {
        "git": true,
        "dpu-runtime-support": true,
        "dpu-audit-menu": true,
        "soplang-builder": true,
        "tasks": true
    },
    "profiles": {
        "default": {
            "env": [
                "ASSISTOS_FS_ROOT",
                "SOUL_GATEWAY_API_KEY",
                {
                    "name": "ONLYOFFICE_PUBLIC_URL",
                    "required": false
                },
                {
                    "name": "ONLYOFFICE_INTERNAL_URL",
                    "required": false
                },
                {
                    "name": "ONLYOFFICE_JWT_SECRET",
                    "required": false
                },
                {
                    "name": "ONLYOFFICE_CALLBACK_BASE_URL",
                    "required": false
                }
            ],
            "preinstall": "scripts/hooks/preinstall.sh"
        }
    }
}
