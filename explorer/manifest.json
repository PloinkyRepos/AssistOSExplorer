{
    "container": "node:20-bullseye",
    "start": "sleep infinity",
    "update": "",
    "cli": "/bin/bash",
    "agent": "node /code/filesystem-http-server.mjs",
    "about": "AssistOS Explorer agent",
    "enable": [
        "soplang",
        "multimedia",
        "gitAgent global",
        "soplangAgent global",
        "tasksAgent global"
    ],
    "repos": {
        "soplangBuilder": "https://github.com/PloinkyRepos/SOPLangBuilder.git",
        "gitMCP": "https://github.com/PloinkyRepos/gitMCP.git",
        "tasksMCP": "https://github.com/PloinkyRepos/tasksMCP"
    },
    "profiles": {
        "default": {
            "env": [
                "ASSISTOS_FS_ROOT"
            ],
            "install": "apt-get update && apt-get install -y git"
        }
    }
}
