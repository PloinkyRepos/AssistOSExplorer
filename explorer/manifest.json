{
    "lite-sandbox": true,
    "container": "node:20-bullseye",
    "update": "",
    "cli": "/bin/bash",
    "agent": "node /code/filesystem-http-server.mjs",
    "about": "AssistOS Explorer agent",
    "ploinky": "pwd enable",
    "pwd": {
        "users": [
            {
                "username": "admin",
                "password": "admin",
                "name": "Admin"
            },
            {
                "username": "qa1",
                "password": "qa1pass",
                "name": "QA 1"
            },
            {
                "username": "qa2",
                "password": "qa2pass",
                "name": "QA 2"
            }
        ]
    },
    "enable": [
        "postgres",
        "keycloak",
        "gitAssistant/gitAgent global",
        "dpuAssistant/dpuAgent global",
        "soplangBuilder/soplangAgent global",
        "tasksAssistant/tasksAgent global",
        "llmAssistant/llmAssistant global"
    ],
    "repos": {
        "soplangBuilder": "https://github.com/PloinkyRepos/SOPLangBuilder.git",
        "gitAssistant": "https://github.com/PloinkyRepos/gitMCP.git",
        "dpuAssistant": "https://github.com/PloinkyRepos/dpuAgent.git",
        "tasksAssistant": "https://github.com/PloinkyRepos/tasksMCP.git",
        "llmAssistant": "https://github.com/PloinkyRepos/llmAssistant.git"
    },
    "applicationPlugins": {
        "git": true,
        "dpu-runtime-support": true,
        "soplang-builder": true,
        "tasks": true
    },
    "profiles": {
        "default": {
            "env": [
                "ASSISTOS_FS_ROOT",
                "SOUL_GATEWAY_API_KEY",
                "ONLYOFFICE_PUBLIC_URL",
                "ONLYOFFICE_INTERNAL_URL",
                "ONLYOFFICE_JWT_SECRET",
                "ONLYOFFICE_CALLBACK_BASE_URL"
            ],
            "preinstall": "scripts/hooks/preinstall.sh",
            "install": "/code/scripts/hooks/install.sh"
        }
    }
}
