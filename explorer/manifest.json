{
    "container": "node:20-alpine",
    "preinstall": "npm install",
    "update": "",
    "cli": "/bin/bash",
    "agent": "node /code/filesystem-http-server.mjs",
    "about": "AssistOS Explorer agent",
    "enable": [
        "soplang",
        "multimedia",
        "gitAgent global",
        "soplangAgent global"
    ],
    "env": [
        "ASSISTOS_FS_ROOT"
    ],
    "repos": {
        "soplangBuilder": "https://github.com/PloinkyRepos/SOPLangBuilder.git",
        "gitMCP": "https://github.com/PloinkyRepos/gitAgent.git"
    }
}
