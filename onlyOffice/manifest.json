{
  "container": "docker.io/assistos/onlyoffice-agent@sha256:eb9ec11b5b58b42a285f580563dea93a67502cd8a296a0df55a39796501809df",
  "entrypoint": "/bin/bash",
  "start": "-lc \"node src/index.mjs\"",
  "about": "OnlyOffice decorator with authenticated control and narrowly public editor transport services.",
  "health": {
    "readiness": {
      "script": "scripts/healthcheck.sh",
      "interval": 2,
      "timeout": 5,
      "failureThreshold": 180,
      "successThreshold": 1
    }
  },
  "httpServices": [
    {
      "slug": "onlyoffice",
      "port": 7000,
      "externalPrefix": "/services/onlyoffice/",
      "internalPrefix": "/control/",
      "access": "authenticated",
      "delegations": [
        {
          "key": "dpuConfidential",
          "targetAgentId": "agent:./dpuAgent",
          "tools": [
            "dpu_workspace_roots",
            "dpu_confidential_list",
            "dpu_confidential_get",
            "dpu_confidential_update"
          ],
          "scopes": [
            "dpu:confidential:read",
            "dpu:confidential:write"
          ],
          "ttlSeconds": 28800,
          "when": {
            "queryParam": "path",
            "pathRoots": [
              "/Confidential"
            ]
          }
        }
      ]
    },
    {
      "slug": "onlyoffice-editor",
      "port": 8080,
      "externalPrefix": "/public-services/onlyoffice-editor/",
      "internalPrefix": "/",
      "access": "public"
    }
  ],
  "volumes": {
    ".ploinky/data/onlyOffice/log": "/var/log/onlyoffice",
    ".ploinky/data/onlyOffice/data": "/var/www/onlyoffice/Data",
    ".ploinky/data/onlyOffice/lib": "/var/lib/onlyoffice",
    ".ploinky/data/onlyOffice/postgresql": "/var/lib/postgresql",
    ".ploinky/data/onlyOffice/rabbitmq": "/var/lib/rabbitmq",
    ".ploinky/data/onlyOffice/redis": "/var/lib/redis"
  },
  "profiles": {
    "default": {
      "preinstall": "scripts/hooks/preinstall.sh",
      "env": [
        { "name": "JWT_ENABLED", "required": false, "default": "true" },
        { "name": "ALLOW_PRIVATE_IP_ADDRESS", "required": false, "default": "true" },
        { "name": "ONLYOFFICE_JWT_SECRET", "varName": "ONLYOFFICE_JWT_SECRET", "required": true, "sharedGeneratedSecret": true },
        { "name": "JWT_SECRET", "varName": "ONLYOFFICE_JWT_SECRET", "required": true, "sharedGeneratedSecret": true },
        { "name": "ONLYOFFICE_EDITOR_PORT", "required": false, "default": "8080" },
        { "name": "ONLYOFFICE_CONTROL_PORT", "required": false, "default": "7000" },
        { "name": "ONLYOFFICE_STORAGE_PORT", "required": false, "default": "9100" },
        { "name": "ONLYOFFICE_SESSION_IDLE_TTL_MS", "required": false, "default": "1800000" },
        { "name": "ONLYOFFICE_CONFIG_JWT_TTL_SECONDS", "required": false, "default": "300" },
        { "name": "ONLYOFFICE_CALLBACK_MAX_BYTES", "required": false, "default": "262144" },
        { "name": "ONLYOFFICE_DOWNLOAD_MAX_BYTES", "required": false, "default": "67108864" },
        { "name": "ONLYOFFICE_IO_TIMEOUT_MS", "required": false, "default": "15000" },
        { "name": "ONLYOFFICE_DRAIN_TIMEOUT_MS", "required": false, "default": "30000" },
        { "name": "ONLYOFFICE_AUTO_ASSEMBLY_ENABLED", "required": false, "default": "true" },
        { "name": "ONLYOFFICE_AUTO_ASSEMBLY_INTERVAL", "required": false, "default": "1m" },
        { "name": "ONLYOFFICE_AUTO_ASSEMBLY_STEP", "required": false, "default": "1m" }
      ]
    },
    "dev": {
