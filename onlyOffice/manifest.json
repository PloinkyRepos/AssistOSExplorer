        { "name": "ONLYOFFICE_IO_TIMEOUT_MS", "required": false, "default": "15000" },
        { "name": "ONLYOFFICE_DRAIN_TIMEOUT_MS", "required": false, "default": "30000" },
        { "name": "ONLYOFFICE_AUTO_ASSEMBLY_ENABLED", "required": false, "default": "true" },
