{
  "name": "@ploinky/assistosexplorer-smoke",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node ./scripts/run-playwright.mjs",
    "test:gpt-researcher": "SMOKE_GPT_RESEARCHER=1 node ./scripts/run-playwright.mjs --project=chromium specs/34-gpt-researcher-routing.spec.mjs",
    "test:umami": "SMOKE_UMAMI=1 node ./scripts/run-playwright.mjs --project=chromium specs/33-umami-routing.spec.mjs",
    "test:webmeet-network-matrix": "node ./scripts/run-webmeet-network-matrix.mjs",
    "test:quick": "node ./scripts/run-playwright.mjs --grep-invert @external",
    "test:unit": "node --test lib/*.test.mjs",
    "test:full": "SMOKE_GITHUB=1 SMOKE_GPT_RESEARCHER=1 SMOKE_ONLYOFFICE=1 SMOKE_UMAMI=1 SMOKE_WEBMEET_MEDIA=1 SMOKE_WEBMEET_SCREEN=1 SMOKE_OPEN_INTERPRETER=1 node ./scripts/run-playwright.mjs --headed",
    "install:browsers": "playwright install chromium",
    "show-report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0"
  }
}
