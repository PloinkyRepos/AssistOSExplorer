{
  "tools": [
    {
      "name": "git_commit_message",
      "title": "Generate Git Commit Message",
      "description": "Generate a Git commit message using an LLM from provided diffs.",
      "command": "tools/git_commit_message.sh",
      "cwd": "workspace",
      "inputSchema": {
        "diffs": {
          "type": "array",
          "description": "List of {repoPath,filePath,diff} items",
          "optional": false,
          "items": {
            "type": "object",
            "properties": {
              "repoPath": { "type": "string" },
              "filePath": { "type": "string" },
              "diff": { "type": "string" }
            },
            "required": ["repoPath", "filePath", "diff"]
          }
        }
      }
    },
    {
      "name": "git_autocommit_tick",
      "title": "Run Git Autocommit Tick",
      "description": "Run one autocommit cycle across repos under the configured root.",
      "command": "tools/git_autocommit_tick.sh",
      "cwd": "workspace",
      "inputSchema": {
        "reposRoot": {
          "type": "string",
          "description": "Repos root path (default: /.ploinky/repos).",
          "optional": true
        },
        "token": {
          "type": "string",
          "description": "Optional Git token for HTTPS auth.",
          "optional": true
        },
        "message": {
          "type": "string",
          "description": "Commit message for autocommits.",
          "optional": true
        },
        "repos": {
          "type": "array",
          "description": "Optional list of repo paths or names to autocommit. When omitted, all repos under reposRoot are used.",
          "optional": true,
          "items": { "type": "string" }
        }
      }
    }
  ]
}
