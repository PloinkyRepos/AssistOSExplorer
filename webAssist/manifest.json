{
    "container": "docker.io/assistos/ploinky-node:24-bookworm-tools",
    "lite-sandbox": true,
    "guest": true,
    "profiles": {
        "default": {
            "env": {
                "ACHILLES_DEBUG": {
                    "required": false
                },
                "SOUL_GATEWAY_API_KEY": {
                    "required": false
                },
                "SOUL_GATEWAY_BASE_URL": {
                    "required": false
                }
            }
        },
        "embedded": {
            "env": {
                "SOUL_GATEWAY_API_KEY": {
                    "required": true,
                    "sharedGeneratedSecret": true
                },
                "SOUL_GATEWAY_BASE_URL": ""
            }
        }
    },
    "cli": "node /code/src/index.mjs",
    "volumes": {
        ".ploinky/repos/AchillesIDE/data": "/data"
    }
}
