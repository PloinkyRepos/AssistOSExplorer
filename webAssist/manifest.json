{
  "container": "docker.io/assistos/ploinky-node:24-bookworm-tools",
  "lite-sandbox": true,
  "guest": true,
  "routerAccess": {
    "httpRoutes": [
      {
        "path": "/IDE-plugins/web-assist-chat/*",
        "access": "guest"
      }
    ]
  },
  "runtime": {
    "resources": {
      "persistentStorage": {
        "key": "webAssist",
        "containerPath": "/workspace/webassist-data"
      },
      "env": {
        "WEBASSIST_DATA_ROOT": "{{STORAGE_CONTAINER_PATH}}/data"
      }
    }
  },
  "volumes": {
    ".data/webAssist/debuglogs": "/code/debuglogs"
  },
  "profiles": {
    "default": {
      "env": {
        "ACHILLES_DEBUG": {
          "required": false
        },
        "OPENCODE_API_KEY": {
          "required": false
        }
      }
    },
    "embedded": {
      "env": {}
    }
  },
  "cli": "node /code/src/index.mjs",
  "ideSettings": [
    {
      "key": "webassist-chat",
      "label": "WebAssist Chat",
      "scope": "workspace",
      "pluginKey": "webAssist/webassist-chat",
      "settingsComponent": "webassist-settings",
      "adminOnly": false
    }
  ]
}
