{
    "tools": [
        {
            "name": "list-sites",
            "title": "List Sites",
            "description": "List all available site IDs from the webAssist data directory.",
            "command": "/code/src/mcp/list-sites.mjs",
            "cwd": "workspace",
            "inputSchema": {
                "dataDir": {
                    "type": "string",
                    "description": "Optional data directory override",
                    "optional": true
                },
                "agentRoot": {
                    "type": "string",
                    "description": "Optional agent root override",
                    "optional": true
                }
            }
        },
        {
            "name": "web_cli_chat",
            "title": "Web CLI Chat",
            "description": "Execute a one-shot webAssist request in MCP mode.",
            "command": "/code/src/index.mjs",
            "args": ["-mcp"],
            "cwd": "workspace",
            "env": {
                "TOOL_NAME": "web_cli_chat"
            },
            "inputSchema": {
                "siteId": {
                    "type": "string",
                    "description": "Website scope id",
                    "optional": false
                },
                "message": {
                    "type": "string",
                    "description": "User message sent to webAssist",
                    "optional": false
                },
                "sessionId": {
                    "type": "string",
                    "description": "Optional session id to reuse",
                    "optional": true
                },
                "json": {
                    "type": "boolean",
                    "description": "Return JSON output from webAssist",
                    "optional": true
                },
                "dataDir": {
                    "type": "string",
                    "description": "Optional data directory override",
                    "optional": true
                },
                "agentRoot": {
                    "type": "string",
                    "description": "Optional agent root override",
                    "optional": true
                }
            }
        },
        {
            "name": "web_cli_history",
            "title": "Web CLI History",
            "description": "Read persisted chat history for a webAssist session.",
            "command": "/code/src/mcp/get-session-history.mjs",
            "cwd": "workspace",
            "inputSchema": {
                "siteId": {
                    "type": "string",
                    "description": "Website scope id",
                    "optional": false
                },
                "sessionId": {
                    "type": "string",
                    "description": "Session id used to load saved chat history",
                    "optional": false
                },
                "dataDir": {
                    "type": "string",
                    "description": "Optional data directory override",
                    "optional": true
                },
                "agentRoot": {
                    "type": "string",
                    "description": "Optional agent root override",
                    "optional": true
                }
            }
        },
        {
            "name": "register-events",
            "title": "Register Events",
            "description": "Register site-scoped events (visit, chat-start, message, consent, lead-notification) to the append-only events log.",
            "command": "/code/src/mcp/register-events.mjs",
            "cwd": "workspace",
            "inputSchema": {
                "siteId": {
                    "type": "string",
                    "description": "Website scope id",
                    "optional": false
                },
                "visitorId": {
                    "type": "string",
                    "description": "Unique browser visitor id",
                    "optional": false
                },
                "eventType": {
                    "type": "string",
                    "description": "Event type: visit, chat-start, message, consent, lead-notification",
                    "optional": false
                },
                "sessionId": {
                    "type": "string",
                    "description": "Optional session id",
                    "optional": true
                },
                "referrer": {
                    "type": "string",
                    "description": "Optional referrer URL",
                    "optional": true
                },
                "country": {
                    "type": "string",
                    "description": "Optional country-level visitor origin",
                    "optional": true
                },
                "openedChat": {
                    "type": "boolean",
                    "description": "Whether the visitor opened the chat surface",
                    "optional": true
                },
                "details": {
                    "type": "object",
                    "description": "Optional additional event details",
                    "optional": true
                },
                "dataDir": {
                    "type": "string",
                    "description": "Optional data directory override",
                    "optional": true
                },
                "agentRoot": {
                    "type": "string",
                    "description": "Optional agent root override",
                    "optional": true
                }
            }
        },
        {
            "name": "fetch-wac",
            "title": "Fetch WAC",
            "description": "Fetch a website's WAC.json file, validate it, and delegate AKU construction to opencode-agent. Returns site-id and success/failure. No code execution — static JSON only.",
            "command": "/code/src/mcp/fetch-wac.mjs",
            "cwd": "workspace",
            "timeoutMs": 300000,
            "inputSchema": {
                "siteUrl": {
                    "type": "string",
                    "description": "Base URL of the website hosting WAC.json",
                    "optional": false
                },
                "invocationToken": {
                    "type": "string",
                    "description": "Ploinky invocation token for agent-to-agent MCP calls",
                    "optional": true
                },
                "dataDir": {
                    "type": "string",
                    "description": "Optional data directory override",
                    "optional": true
                },
                "agentRoot": {
                    "type": "string",
                    "description": "Optional agent root override",
                    "optional": true
                }
            }
        }
    ]
}
