{
    "agent": "sh /code/scripts/startAgent.sh",
    "container": "node:20-alpine",
    "identity": {
        "principalId": "agent:gitAgent",
        "agentName": "gitAgent"
    },
    "requires": {
        "secretStore": {
            "contract": "secret-store/v1",
            "maxScopes": ["secret:read", "secret:write"]
        }
    },
    "capabilities": {
        "dpu": {
            "allowedRoles": [
                "read"
            ]
        }
    },
    "profiles": {
        "default": {
            "env": [
                "OPENAI_API_KEY",
                "ANTHROPIC_API_KEY",
                "GEMINI_API_KEY",
                "MISTRAL_API_KEY",
                "DEEPSEEK_API_KEY",
                "OPENROUTER_API_KEY",
                "ASSISTOS_FS_ROOT",
                "WORKSPACE_ROOT",
                "PLOINKY_WORKSPACE_ROOT",
                "SOUL_GATEWAY_API_KEY"
            ]
        }
    }
}
