{
    "agent": "sh /code/scripts/startAgent.sh",
    "container": "node:20-alpine",
    "lite-sandbox": true,
    "profiles": {
        "default": {
            "install": "if [ \"${PLOINKY_RUNTIME:-}\" = \"bwrap\" ] || [ \"${PLOINKY_RUNTIME:-}\" = \"seatbelt\" ]; then command -v git >/dev/null 2>&1 || { echo \"ERROR: git not found on host. Install git or set ASSISTOS_GIT_BINARY to the full path of the git binary.\"; exit 1; }; elif command -v apk >/dev/null 2>&1; then apk add --no-cache git openssh-client ca-certificates; fi",
            "env": [
                "OPENAI_API_KEY",
                "ANTHROPIC_API_KEY",
                "GEMINI_API_KEY",
                "MISTRAL_API_KEY",
                "DEEPSEEK_API_KEY",
                "OPENROUTER_API_KEY",
                "ASSISTOS_FS_ROOT",
                "WORKSPACE_ROOT",
                "PLOINKY_WORKSPACE_ROOT",
                "SOUL_GATEWAY_API_KEY",
                "SOUL_GATEWAY_BASE_URL",
                "PLOINKY_ROUTER_URL",
                "PLOINKY_ROUTER_HOST",
                "PLOINKY_ROUTER_PORT",
                "PLOINKY_AGENT_PRINCIPAL",
                "PLOINKY_DPU_ROUTE",
                "PLOINKY_INVOCATION_TOKEN"
            ]
        }
    }
}
