{
  "agent": "sh /code/scripts/startAgent.sh",
  "container": "node:24.15.0-alpine",
  "lite-sandbox": true,
  "profiles": {
    "default": {
      "env": [
        "ASSISTOS_FS_ROOT",
        "WORKSPACE_ROOT",
        "PLOINKY_WORKSPACE_ROOT",
        {
          "name": "SOUL_GATEWAY_API_KEY",
          "required": true,
          "derive": "derived-master",
          "deriveRepoName": "proxies",
          "deriveAgentName": "soul-gateway",
          "deriveName": "workspace-default-api-key"
        },
        {
          "name": "SOUL_GATEWAY_BASE_URL",
          "required": false
        }
      ]
    }
  }
}
