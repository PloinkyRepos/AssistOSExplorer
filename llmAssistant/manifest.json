{
  "agent": "sh /code/scripts/startAgent.sh",
  "container": "node:24.15.0-alpine",
  "lite-sandbox": true,
  "profiles": {
    "default": {
      "env": {
        "ASSISTOS_FS_ROOT": {
          "required": false
        },
        "WORKSPACE_ROOT": {
          "required": false
        },
        "PLOINKY_WORKSPACE_ROOT": {
          "required": false
        },
        "SOUL_GATEWAY_API_KEY": {
          "required": false
        },
        "SOUL_GATEWAY_BASE_URL": {
          "required": false
        }
      }
    },
    "embedded": {
      "env": {
        "SOUL_GATEWAY_API_KEY": {
          "required": true,
          "derive": "derived-master",
          "deriveRepoName": "proxies",
          "deriveAgentName": "soul-gateway",
          "deriveName": "workspace-default-api-key"
        },
        "SOUL_GATEWAY_BASE_URL": ""
      }
    }
  }
}
